---
import BetaSignupForm from "../components/BetaSignupForm.svelte";
import DownloadIOS from "../components/DownloadIOS.svelte";
import NavCta from "../components/NavCta.svelte";
import "../styles/ease-tokens.css";

// The glyphs are the Ease design system's event icons (24 px grid, filled).
// `c` is the glyph colour, `h` the colour of the holes cut into it.
const GLYPH = {
  attack: (c: string) => `<path d="M13 2 5 14h6l-1 8 8-12h-6z" fill="${c}"/>`,
  dose: (c: string) =>
    `<g fill="${c}"><rect x="1.5" y="8.5" width="21" height="7" rx="3.5" transform="rotate(-38 12 12)"/><rect x="1.5" y="8.5" width="21" height="7" rx="3.5" transform="rotate(38 12 12)" opacity=".8"/></g>`,
  note: (c: string, h: string) =>
    `<rect x="5" y="3" width="14" height="18" rx="2.5" fill="${c}"/><path d="M8.5 9h7M8.5 13h7M8.5 17h4" stroke="${h}" stroke-width="1.8" stroke-linecap="round"/>`,
  visit: (c: string, h: string) =>
    `<rect x="9" y="3.5" width="6" height="4" rx="1.2" fill="${c}"/><rect x="2.5" y="6.5" width="19" height="14.5" rx="3" fill="${c}"/><path d="M12 10.2v7.2M8.4 13.8h7.2" stroke="${h}" stroke-width="2.4" stroke-linecap="round"/>`,
  list: (c: string) =>
    `<g stroke="${c}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M3.5 7.5l2.2 2.2L9.5 6M12 8h8.5M3.5 16.5l2.2 2.2 3.8-3.7M12 17h8.5"/></g>`,
  start: (c: string) =>
    `<path d="M5 3v18M5 4h11l-2 4 2 4H5" fill="${c}" stroke="${c}" stroke-width="2" stroke-linejoin="round"/>`,
  // Not an event kind: drawn in the same filled style for the privacy card.
  lock: (c: string, h: string) =>
    `<rect x="4.5" y="10" width="15" height="11" rx="2.5" fill="${c}"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="${c}" stroke-width="2.2" fill="none" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.7" fill="${h}"/>`,
};
type Glyph = keyof typeof GLYPH;
const glyph = (k: Glyph, x: number, y: number, size: number, c: string, h = "var(--ground)") =>
  `<g transform="translate(${x - size / 2} ${y - size / 2}) scale(${size / 24})">${GLYPH[k](c, h)}</g>`;
const icon = (k: Glyph, c = "var(--ink)", h = "var(--card2)") =>
  `<svg viewBox="0 0 24 24" aria-hidden="true">${GLYPH[k](c, h)}</svg>`;

// ── The hero path ────────────────────────────────────────────────────────────
// A port of ease-kotlin's StreamGeometry (decisions 0003/0004), turned on its side so
// time runs left to right: content y becomes x, and the app's lateral x becomes y. The
// constants are the app's, in dp. Only the frame differs: the days are spread to fill
// the hero, and every random draw comes from one generator seeded with a start day, in
// the same order the app draws them, so the picture is identical on every build.
const TAU = 6.283;
let rs = 20260715 >>> 0; // mulberry32, seeded with the path's start day
const rand = () => {
  rs = (rs + 0x6d2b79f5) >>> 0;
  let t = rs;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const rnd = (a: number, b: number) => a + rand() * (b - a);
/** The two-sine wander every strand shares: [-1.5, 1.5]. */
const wander = (l1a: number, l1b: number, l2a: number, l2b: number) => {
  const l1 = rnd(l1a, l1b), l2 = rnd(l2a, l2b), p1 = rand(), p2 = rand();
  return (s: number) => Math.sin(TAU * (s / l1 + p1)) + 0.5 * Math.sin(TAU * (s / l2 + p2));
};
const sstep = (x: number) => { const t = Math.max(0, Math.min(1, x)); return t * t * (3 - 2 * t); };

// Seeded in the app's order: the lived wander, 12 drifts, 32 future strands (the last 5 accented).
const past = wander(220, 420, 90, 160);
const drifts = Array.from({ length: 12 }, () => ({ w: wander(160, 320, 70, 130), amp: rnd(14, 26) }));
const strands = Array.from({ length: 32 }, (_, i) => ({ accent: i >= 27, w: wander(220, 420, 90, 160), dir: rnd(-1, 1), spread: rnd(0.6, 1.4) }));

const HW = 1200, MID = 92;
const TODAY = 700;          // today's ring
const PLUS = TODAY + 210;   // ring0 = plusY - 210
const EDGE = HW + 60;       // the spray runs 60 dp past the edge, as it runs past the screen's bottom

// The days, oldest first. PathLayoutEngine gives a quiet day 22 dp and an event day 48 dp; the
// pitch is scaled so the start of the path lands near the left edge.
type Kind = "d" | "u" | "start" | "attack" | "dose" | "note";
const SEQ: Kind[] = ["start", "d", "d", "u", "d", "attack", "d", "d", "d", "d", "dose", "d", "u", "d", "note", "d", "d", "attack", "d", "d", "d", "dose", "d", "d", "u", "d", "d"];
const pitch = (k: Kind) => (k === "d" || k === "u" ? 22 : 48);
const total = SEQ.reduce((a, k) => a + pitch(k), 0);
const K = (TODAY - 70) / total;
const days: { x: number; k: Kind }[] = [];
{ let x = TODAY; for (let i = SEQ.length - 1; i >= 0; i--) { x -= pitch(SEQ[i]) * K; days.unshift({ x, k: SEQ[i] }); } }
const FILL: Record<string, string> = { start: "var(--sage)", attack: "var(--coral)", dose: "var(--ink)", note: "var(--ink)" };
const large = days.filter((d) => d.k !== "d" && d.k !== "u").map((d) => d.x);
const small = days.filter((d) => d.k === "d" || d.k === "u").map((d) => d.x);
const driftPins = [...large, TODAY];
const startX = days[0].x;

/** The lived path wanders and settles onto today's ring with a flat tangent (pastX). */
const pastY = (x: number) => { const s = TODAY - x; const t = sstep(s / 140); return MID + 30 * t * past(s) / 1.5; };
/** A bump with flat ends between two pins (driftEnv). */
const driftEnv = (x: number) => {
  for (let i = 0; i < driftPins.length - 1; i++) {
    const a = driftPins[i], b = driftPins[i + 1];
    if (x >= a && x <= b && b > a) { const u = (x - a) / (b - a); return 16 * u * u * (1 - u) * (1 - u); }
  }
  return 0;
};
/** The drift is threaded through every quiet day too: a Gaussian pinch at each small dot. */
const thread = (x: number) => small.reduce((f, s) => f * (1 - Math.exp(-Math.pow((x - s) / (9 * K), 2))), 1);
/** Everything on the lived path is pulled into the plus as it passes it. */
const pinch = (x: number) => 1 - Math.exp(-Math.pow((x - PLUS) / 70, 2));
const pinched = (x: number, y: number) => MID + (y - MID) * pinch(x);

/** Catmull-Rom through the points, emitted as cubic Beziers (PointBuf.toPath). */
const catmull = (p: [number, number][]) => {
  let d = `M${p[0][0].toFixed(1)} ${p[0][1].toFixed(1)}`;
  for (let i = 0; i < p.length - 1; i++) {
    const a = p[Math.max(i - 1, 0)], b = p[i], c = p[i + 1], e = p[Math.min(i + 2, p.length - 1)];
    d += `C${(b[0] + (c[0] - a[0]) / 6).toFixed(1)} ${(b[1] + (c[1] - a[1]) / 6).toFixed(1)} ${(c[0] - (e[0] - b[0]) / 6).toFixed(1)} ${(c[1] - (e[1] - b[1]) / 6).toFixed(1)} ${c[0].toFixed(1)} ${c[1].toFixed(1)}`;
  }
  return d;
};

// Samples: a fixed grid (24 dp for the line, 16 dp for the drifts) plus every dot's centre.
const grid = (step: number) => {
  const xs: number[] = [];
  for (let x = startX; x < TODAY; x += step) xs.push(x);
  return [...new Set([...xs, ...days.map((d) => d.x), TODAY])].sort((a, b) => a - b);
};
const lived = catmull(grid(24).map((x): [number, number] => [x, pinched(x, pastY(x))]));
const driftPaths = drifts.map((dr) =>
  catmull(grid(16).map((x): [number, number] => [x, pinched(x, pastY(x) + dr.amp * driftEnv(x) * thread(x) * dr.w(TODAY - x) / 1.5)])),
);

// The future stream (strandPoints): a bridge from today's ring to the plus, sampled every 24 dp
// by distance past today, then five spray points out past the edge.
const futurePaths = strands.map((st) => {
  const pts: [number, number][] = [];
  const length = PLUS - TODAY;
  const count = Math.max(2, Math.ceil(length / 24));
  const amp = (st.accent ? 22 : 34) * Math.min(1, length / 210);
  for (let i = 0; i <= count; i++) {
    const x = TODAY + (i / count) * length, u = (x - TODAY) / length;
    const env = amp * 16 * u * u * (1 - u) * (1 - u);
    pts.push([x, MID + env * st.w(x - TODAY) / 1.5]);
  }
  for (let j = 1; j <= 5; j++) {
    const v = j / 5, x = PLUS + v * (EDGE - PLUS);
    const wild = Math.pow(v, 1.1) * 130 * st.spread;
    pts.push([x, MID + wild * (st.dir + 0.35 * st.w(x - TODAY))]);
  }
  return { d: catmull(pts), accent: st.accent };
});

const GLYPH_OF: Record<string, Glyph> = { start: "start", attack: "attack", dose: "dose", note: "note" };
const dayMarks = days.map((d) => {
  const y = pinched(d.x, pastY(d.x));
  if (d.k === "d") return `<circle class="hp-day" cx="${d.x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.4"/>`;
  if (d.k === "u") return `<circle class="hp-unconfirmed" cx="${d.x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.4"/>`;
  return `<circle cx="${d.x.toFixed(1)}" cy="${y.toFixed(1)}" r="17" fill="${FILL[d.k]}"/>` + glyph(GLYPH_OF[d.k], d.x, y, 15, "var(--ground)", FILL[d.k]);
}).join("");

const heroPath = `
<defs>
  <linearGradient id="hp-lived" gradientUnits="userSpaceOnUse" x1="${startX.toFixed(0)}" y1="0" x2="${TODAY}" y2="0">
    <stop offset="0" style="stop-color:var(--ice-light)"/><stop offset="1" style="stop-color:var(--ice-deep)"/>
  </linearGradient>
  <linearGradient id="hp-future" gradientUnits="userSpaceOnUse" x1="${TODAY}" y1="0" x2="${HW}" y2="0">
    <stop offset="0" style="stop-color:var(--ice-pale)"/><stop offset=".45" style="stop-color:var(--ice-mid)"/><stop offset="1" style="stop-color:var(--ice-deep)"/>
  </linearGradient>
</defs>
${futurePaths.filter((f) => !f.accent).map((f) => `<path class="hp-future" d="${f.d}"/>`).join("")}
${futurePaths.filter((f) => f.accent).map((f) => `<path class="hp-future-glow" d="${f.d}"/><path class="hp-future-accent" d="${f.d}"/>`).join("")}
${driftPaths.map((d) => `<path class="hp-drift" d="${d}"/>`).join("")}
<path class="hp-lived-halo" d="${lived}"/><path class="hp-lived" d="${lived}"/>
${dayMarks}
<circle class="hp-today" cx="${TODAY}" cy="${MID}" r="13"/>
<circle class="hp-plus" cx="${PLUS}" cy="${MID}" r="32"/>
<g class="hp-plus-cross" transform="translate(${PLUS} ${MID})"><rect x="-14" y="-2" width="28" height="4" rx="2"/><rect x="-2" y="-14" width="4" height="28" rx="2"/></g>`;

// ── A recent week, drawn as a stretch of the path ────────────────────────────
const line = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join("");
const WEEK = [
  { d: "Mon", n: 28, k: "d" }, { d: "Tue", n: 29, k: "d" },
  { d: "Wed", n: 30, k: "attack", fill: "var(--coral)", label: "attack" },
  { d: "Thu", n: 31, k: "u" },
  { d: "Fri", n: 1, k: "dose", fill: "var(--ink)", label: "dose" },
  { d: "Sat", n: 2, k: "d" }, { d: "Sun", n: 3, k: "today" },
] as const;
const WX = (i: number) => 26 + i * 46;
const WY = (i: number) => 38 + 4 * Math.sin(i * 1.3);
const weekLine = line(Array.from({ length: 61 }, (_, j) => { const i = (j / 60) * 6; return [26 + i * 46, 38 + 4 * Math.sin(i * 1.3)]; }));
const weekMarks = WEEK.map((w, i) => {
  const x = WX(i), y = WY(i);
  let mark = "";
  if (w.k === "d") mark = `<circle class="hp-day" cx="${x}" cy="${y.toFixed(1)}" r="3.4"/>`;
  else if (w.k === "u") mark = `<circle class="hp-unconfirmed" cx="${x}" cy="${y.toFixed(1)}" r="3.4"/>`;
  else if (w.k === "today") mark = `<circle class="hp-today" cx="${x}" cy="${y.toFixed(1)}" r="11"/>`;
  else mark = `<circle cx="${x}" cy="${y.toFixed(1)}" r="15" fill="${w.fill}"/>` + glyph(w.k, x, y, 13, "var(--ground)", w.fill);
  return mark +
    `<text class="wk-day" x="${x}" y="84" text-anchor="middle">${w.d.toUpperCase()}</text>` +
    `<text class="wk-num${w.k === "today" ? " wk-today" : ""}" x="${x}" y="100" text-anchor="middle">${w.n}</text>`;
}).join("");
const weekLabel = "Recent week: Monday and Tuesday quiet, an attack on Wednesday, Thursday not yet confirmed, a dose on Friday, Saturday quiet, today is Sunday.";

const FEATURES: { title: string; body: string; glyph: Glyph; color?: string }[] = [
  { title: "Treatment trials", body: "Keep medications, dates, dosages, and reasons for stopping together.", glyph: "dose" },
  { title: "Quick outcome logging", body: "Record benefit, side effects, and migraine days in a few taps, even on difficult days.", glyph: "attack", color: "var(--coral)" },
  { title: "Privacy first", body: "You decide what to record and when to share it. We do not sell your personal data.", glyph: "lock" },
  { title: "Treatment timeline", body: "See past and current medication trials in one chronological, patient-owned record.", glyph: "start" },
  { title: "Appointment-ready reports", body: "Turn your history into a concise summary to review with your clinician.", glyph: "visit" },
  { title: "Low-burden check-ins", body: "Short prompts keep your history current without asking for a long daily diary.", glyph: "list" },
];
const FAVICON = "data:image/svg+xml," + encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><circle cx='32' cy='32' r='32' fill='#4a4845'/><rect x='17' y='29' width='30' height='6' rx='3' fill='#fbf6ed'/><rect x='29' y='17' width='6' height='30' rx='3' fill='#fbf6ed'/></svg>",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ease — Migraine Treatment History</title>
    <meta name="description" content="Keep a clear history of migraine medication trials, outcomes, and questions for your next appointment. Join the private beta." />
    <meta name="theme-color" content="#FBF6ED" />
    <!-- Social sharing (og:image still TODO — needs a real 1200×630 asset in /public) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ease — Migraine Treatment History" />
    <meta property="og:description" content="Record migraine medication trials and turn them into a clear history you can review and share with your clinician. Join the beta." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Ease — Migraine Treatment History" />
    <meta name="twitter:description" content="Record migraine medication trials and turn them into a clear history you can review and share with your clinician. Join the beta." />
    <link rel="icon" type="image/svg+xml" href={FAVICON} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <a class="skip-link" href="#main">Skip to content</a>

    <!-- ░░ NAV ░░ -->
    <header class="nav">
      <div class="nav-inner">
        <a class="logo" href="/">Ease</a>
        <nav aria-label="Main navigation">
          <a href="#features">Features</a>
          <a href="#about">About</a>
          <a href="#roadmap">Roadmap</a>
          <a href="/profile">Profile</a>
          <a href="/dashboard">Dashboard</a>
          <NavCta client:load />
        </nav>
      </div>
    </header>

    <main id="main">

    <!-- ░░ HERO ░░ -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow reveal">MIGRAINE TREATMENT HISTORY · PRIVATE BETA</p>
        <h1 class="hero-title reveal" style="--d:80ms">
          Your migraine treatment.<br /><em>One clear history.</em>
        </h1>
        <p class="hero-sub reveal" style="--d:160ms">
          Record clinician-directed medication trials, what happened, and what to bring to your next appointment. Fast to update. Yours to review and share.
        </p>
        <div class="hero-form reveal" id="beta" style="--d:240ms">
          <BetaSignupForm client:load />
        </div>
        <div class="hero-app reveal" style="--d:320ms">
          <DownloadIOS client:load />
        </div>
      </div>
      <svg class="hero-path" viewBox={`0 0 ${HW} 184`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={heroPath} />
    </section>

    <!-- ░░ FEATURES ░░ -->
    <section class="section features" id="features">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">WHAT EASE DOES</p>
          <h2>What you can keep in Ease</h2>
        </div>
        <div class="features-grid">
          {FEATURES.map((f, i) => (
            <article class="card reveal" style={`--d:${i * 60}ms`}>
              <div class="card-icon" set:html={icon(f.glyph, f.color)} />
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ APPROACH ░░ -->
    <section class="section" id="about">
      <div class="container">
        <div class="philosophy reveal">
          <div class="philosophy-text">
            <p class="eyebrow">OUR APPROACH</p>
            <h2>Built for the reality of migraine treatment.</h2>
            <p class="body-text">
              Appointments are short and treatment histories get fragmented. Ease keeps the details together without adding another demanding routine.
            </p>
            <p class="body-text body-text-last">
              It counts what happened. What it means is for you and your clinician to decide.
            </p>
          </div>

          <figure class="philosophy-vis">
            <svg class="week" viewBox="0 0 328 108" role="img" aria-label={weekLabel}>
              <path class="hp-lived-halo" d={weekLine} />
              <path class="week-line" d={weekLine} />
              <Fragment set:html={weekMarks} />
            </svg>
            <figcaption class="vis-label">YOUR RECENT HISTORY</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ░░ ROADMAP ░░ -->
    <section class="section roadmap" id="roadmap">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">ROADMAP</p>
          <h2>From a clear treatment history<br /><span class="text-muted">to better-informed appointments.</span></h2>
        </div>
        <div class="roadmap-grid">

          <div class="rm-card reveal" style="--d:0ms">
            <span class="rm-marker rm-marker-now" aria-hidden="true"></span>
            <div class="rm-header">
              <span class="rm-badge badge-now">Now</span>
              <span class="rm-phase">Phase 1</span>
            </div>
            <h3 class="rm-title">Treatment History</h3>
            <ul class="rm-list">
              <li>Clinician-directed medication trial records</li>
              <li>Quick benefit and side-effect logging</li>
              <li>Migraine-day and severity history</li>
              <li>Patient-owned chronological timeline</li>
              <li>Appointment-ready report export</li>
            </ul>
          </div>

          <div class="rm-card reveal" style="--d:80ms">
            <span class="rm-marker" aria-hidden="true"></span>
            <div class="rm-header">
              <span class="rm-badge">In development</span>
              <span class="rm-phase">Phase 2</span>
            </div>
            <h3 class="rm-title">Workflow Validation</h3>
            <ul class="rm-list">
              <li>Beta-user interviews and usability testing</li>
              <li>Clinician review of the report format</li>
              <li>Low-burden outcome measures</li>
              <li>Consent and data-governance workflows</li>
              <li>Pilot operations and support workflows</li>
            </ul>
          </div>

          <div class="rm-card reveal" style="--d:160ms">
            <span class="rm-marker" aria-hidden="true"></span>
            <div class="rm-header">
              <span class="rm-badge">Planned</span>
              <span class="rm-phase">Phase 3</span>
            </div>
            <h3 class="rm-title">Shadow Research</h3>
            <ul class="rm-list">
              <li>Prospective observational cohort</li>
              <li>Pre-specified evaluation protocol</li>
              <li>No user-facing predictions or treatment advice</li>
              <li>Calibration and subgroup performance checks</li>
              <li>Independent clinical and statistical review</li>
            </ul>
          </div>

          <div class="rm-card reveal" style="--d:240ms">
            <span class="rm-marker" aria-hidden="true"></span>
            <div class="rm-header">
              <span class="rm-badge">Target</span>
              <span class="rm-phase">Phase 4</span>
            </div>
            <h3 class="rm-title">Regulated Product, If Validated</h3>
            <ul class="rm-list">
              <li>Intended-purpose and classification assessment</li>
              <li>Quality and risk management systems</li>
              <li>Clinical performance and utility evidence</li>
              <li>Human factors and cybersecurity validation</li>
              <li>Regulatory submission only after evidence gates</li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    </main>

    <!-- ░░ FOOTER ░░ -->
    <footer class="footer">
      <div class="container">
        <div class="footer-row">
          <a class="logo logo-footer" href="/">ease</a>
          <div class="footer-links">
            <a href="/privacy">Privacy Policy</a>
            <a href="/terms">Terms of Use</a>
          </div>
          <p class="footer-copy">© 2026 Ease Health</p>
        </div>
      </div>
    </footer>

    <script>
      // ── Scroll reveal ──────────────────────────────────────
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        }),
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* The shared components (signup form, OAuth buttons, App Store badge) read these
     older names. Point them at the Ease tokens; pages still on the dark theme keep
     their own values. */
  :root {
    --bg:        var(--ground);
    --surface:   var(--card);
